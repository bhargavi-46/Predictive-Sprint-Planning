# Copy this file to .env and adjust the values.

PORT=4000

# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/agile_task_manager

# Use a long random string in anything other than local development.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin allowed to call the API and open a websocket.
CLIENT_ORIGIN=http://localhost:5173
